{
  "rewrites": [
    { "source": "/sitemap-index.xml", "destination": "/sitemap.xml" },
    { "source": "/sitemap.xml/", "destination": "/sitemap.xml" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ]
}
