# Public site URL (canonical links, Open Graph, sitemap). Set in Vercel when domain is ready.
PUBLIC_SITE_URL=http://localhost:4321

# Optional: mock "today" for pricing/registration testing (Belgrade dates).
# Example: 2026-09-03 = Super Early Bird closed, Early Bird open
# PUBLIC_REGISTRATION_NOW=2026-09-03

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Dev works with Cloudflare test keys if these are unset.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
