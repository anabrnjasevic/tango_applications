# Public site URL (canonical links, Open Graph, sitemap).
# Production falls back to the Vercel production domain if this is unset or localhost.
PUBLIC_SITE_URL=http://localhost:4321

# Google Search Console HTML-tag verification code (the content="..." value).
PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional: mock "today" for pricing/registration testing (Belgrade dates).
# Example: 2026-09-03 = Super Early Bird closed, Early Bird open
# PUBLIC_REGISTRATION_NOW=2026-09-03

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
# Local `astro dev` skips Turnstile. Hosts without both keys skip it too.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Apps Script web app (scripts/google-form-webhook.gs).
# Required: Google blocks automated formResponse posts with CAPTCHA.
# Execute as: Me. Who has access: Anyone. Redeploy after changing the script.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_FORM_WEBHOOK_SECRET=
