---
import { copy, schedule } from '../data/site';
import { getRegistrationState } from '../lib/registration-schedule';

const registration = getRegistrationState();

const scheduleByDay = schedule.reduce<{ day: string; items: typeof schedule[number][] }[]>(
  (groups, item) => {
    const last = groups[groups.length - 1];
    if (!last || last.day !== item.day) {
      groups.push({ day: item.day, items: [item] });
    } else {
      last.items.push(item);
    }
    return groups;
  },
  [],
);
---

<section id="schedule" class="section-pad bg-surface-elevated">
  <div class="mx-auto grid max-w-7xl gap-16 lg:grid-cols-[1fr_2fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 data-reveal="left" class="font-display text-4xl leading-tight text-white md:text-6xl">
        Your journey through the event
      </h2>
      <div data-reveal="left" data-reveal-delay="100" class="mt-6 space-y-1 text-lg text-white/70">
        {copy.scheduleIntroLines.map((line) => (
          <p>{line}</p>
        ))}
      </div>
      <p
        data-reveal="left"
        data-reveal-delay="150"
        class="mt-6 rounded-xl border border-white/10 bg-surface-card px-4 py-4 text-base leading-relaxed text-white/70"
      >
        {copy.milongaVenuesNote}
      </p>
      <a data-reveal="left" data-reveal-delay="200" href={registration.ctaHref} class="btn-primary mt-8">
        {registration.ctaLabel}
      </a>
    </div>

    <div class="space-y-14">
      {scheduleByDay.map((group, groupIndex) => (
        <section data-reveal data-reveal-delay={String(groupIndex * 80)}>
          <h3 class="font-display text-3xl text-brand-light md:text-4xl">{group.day}</h3>
          <ol class="mt-6 space-y-8">
            {group.items.map((item) => (
              <li class="border-l border-white/15 pl-5">
                <p class="text-sm font-semibold uppercase tracking-wider text-brand">{item.time}</p>
                <h4 class="mt-2 font-display text-2xl text-white">{item.title}</h4>
                {'subtitle' in item && item.subtitle && (
                  <p class="mt-1 text-lg text-brand-light">{item.subtitle}</p>
                )}
                {'venue' in item && item.venue && (
                  <p class="mt-2 text-sm font-medium text-brand-light">{item.venue}</p>
                )}
                {'venueNote' in item && item.venueNote && (
                  <p class="mt-2 text-sm font-medium text-brand">{item.venueNote}</p>
                )}
                <div class="mt-3">
                  <p class="text-sm font-semibold uppercase tracking-wider text-white/60">{item.tag}</p>
                  <div class="mt-2 space-y-2 text-white/65">
                    {item.details.map((detail) => (
                      <p>{detail}</p>
                    ))}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</section>
