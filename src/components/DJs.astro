---
import { djs } from '../data/site';
---

<section id="djs" class="section-pad bg-surface">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 data-reveal="left" class="font-display text-4xl text-white md:text-6xl">Meet Our DJs</h2>
      <p data-reveal="right" class="max-w-md text-white/70">
        Curated tandas every night — from golden age classics to modern nuevo, always danceable.
      </p>
    </div>

    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {djs.map((dj, index) => (
        <article
          data-reveal="scale"
          data-reveal-delay={String(index * 120)}
          class="group overflow-hidden rounded-2xl border border-white/10 bg-surface-card transition-all duration-300 hover:-translate-y-1 hover:border-white/20 hover:shadow-lg hover:shadow-black/30"
        >
          <div class="overflow-hidden">
            <img
              src={dj.image}
              alt={dj.name}
              class="aspect-square w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
          <div class="p-6">
            <h3 class="font-display text-2xl text-white">{dj.name}</h3>
            <p class="mt-1 text-brand-light">{dj.role}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
