---
import { copy, pricing, site } from '../data/site';
import {
  getDefaultPricingTab,
  getPeriodStateById,
  getRegistrationState,
} from '../lib/registration-schedule';

const registration = getRegistrationState();
const defaultPeriod = getDefaultPricingTab();
---

<section id="tickets" class="section-pad bg-surface">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 text-center">
      <h2 data-reveal="fade" class="font-display text-4xl text-white md:text-6xl">{pricing.headline}</h2>
      <p data-reveal="fade" data-reveal-delay="100" class="mt-4 text-xl text-brand-light">{registration.message}</p>
    </div>

    <div data-reveal="fade" data-reveal-delay="150" class="mb-10 flex flex-wrap justify-center gap-x-3 gap-y-4">
      {
        pricing.periods.map((period) => {
          const periodState = getPeriodStateById(period.id);
          const isDefault = period.id === defaultPeriod;
          const isActive = periodState?.status === 'active';
          const isClosed = periodState?.showStrikethrough ?? false;
          const isUpcoming = periodState?.status === 'upcoming';
          const dateLabel =
            'dates' in period && period.dates
              ? period.dates
              : 'startDate' in period && 'endDate' in period
                ? `${period.startDate.slice(8, 10)}/${period.startDate.slice(5, 7)} - ${period.endDate.slice(8, 10)}/${period.endDate.slice(5, 7)}`
                : null;

          return (
            <div class="flex flex-col items-center gap-1.5">
              <button
                type="button"
                data-pricing-tab={period.id}
                data-period-status={periodState?.status ?? 'upcoming'}
                class:list={[
                  'relative overflow-visible rounded-full border px-5 py-2.5 text-sm font-semibold uppercase tracking-wider transition-all duration-300',
                  isDefault && isActive
                    ? 'border-brand bg-brand text-black'
                    : isDefault && !isActive
                      ? 'border-brand/60 bg-brand/20 text-white'
                      : 'border-white/20 text-white/70 hover:border-white/40 hover:text-white',
                  isClosed && 'pricing-tab--closed',
                  isUpcoming && !isClosed && 'opacity-80',
                ]}
              >
                <span class="relative z-0">{period.name}</span>
                {
                  isClosed && (
                    <img
                      src="/images/pricing-tab-strike.png"
                      alt=""
                      aria-hidden="true"
                      class="pricing-tab-strike pointer-events-none"
                    />
                  )
                }
              </button>
              {dateLabel && (
                <span class="text-xs text-white/60">{dateLabel}</span>
              )}
              {'footnoteNoteId' in period && period.footnoteNoteId && (
                <span
                  role="link"
                  tabindex="0"
                  data-pricing-footnote={period.footnoteNoteId}
                  class="text-xs text-white/50 underline-offset-2 hover:underline"
                >
                  * More info
                </span>
              )}
            </div>
          );
        })
      }
    </div>

    {
      pricing.periods.map((period) => {
        const periodState = getPeriodStateById(period.id);
        const canRegisterFromPanel = periodState?.canRegister ?? false;

        return (
          <div
            data-pricing-panel={period.id}
            class:list={['space-y-8', period.id === defaultPeriod ? '' : 'hidden']}
          >
            <div class="grid gap-6 sm:grid-cols-2">
              {period.packages.map((tier, index) => (
                <article
                  data-reveal="scale"
                  data-reveal-delay={String(index * 100)}
                  class:list={[tier.featured ? 'card-brand' : 'card-dark', 'flex flex-col']}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class:list={['font-display text-2xl', tier.featured ? 'text-black' : 'text-white']}>
                        {tier.name}
                      </h3>
                      <p class:list={['mt-1 text-sm', tier.featured ? 'text-black/70' : 'text-white/60']}>
                        {tier.description}
                      </p>
                    </div>
                    <p class:list={['font-display text-5xl', tier.featured ? 'text-black' : 'text-brand']}>
                      {tier.price}
                    </p>
                  </div>

                  {
                    canRegisterFromPanel ? (
                      <a
                        href={site.registerUrl}
                        class:list={[
                          'mt-8 inline-flex justify-center rounded-full px-6 py-3 text-sm font-semibold uppercase tracking-wider transition-all duration-300 hover:scale-105 active:scale-95',
                          tier.featured
                            ? 'bg-black text-white hover:bg-black/80'
                            : 'bg-brand text-black hover:bg-brand-light',
                        ]}
                      >
                        {copy.heroCtaRegister}
                      </a>
                    ) : (
                      <span
                        class:list={[
                          'mt-8 inline-flex cursor-not-allowed justify-center rounded-full px-6 py-3 text-sm font-semibold uppercase tracking-wider opacity-60',
                          tier.featured
                            ? 'bg-black/50 text-white/70'
                            : 'border border-white/20 text-white/50',
                        ]}
                        aria-disabled="true"
                      >
                        {periodState?.showStrikethrough
                          ? copy.periodClosed
                          : period.id === 'day-of'
                            ? copy.periodAtDoor
                            : (periodState?.opensLabel ??
                                (periodState?.status === 'upcoming'
                                  ? copy.periodNotYetOpen
                                  : copy.periodClosed))}
                      </span>
                    )
                  }
                </article>
              ))}
            </div>

            {
              period.individuals.length > 0 && (
                <div class="rounded-2xl border border-white/10 bg-surface-card p-6 md:p-8">
                  <h3 class="font-display text-2xl text-white">Individual tickets</h3>
                  <div class="mt-6 space-y-6">
                    {period.individuals.map((group) => (
                      <div>
                        <div class="mb-3 flex items-center justify-between gap-4">
                          <h4 class="font-display text-lg text-white">{group.category}</h4>
                          <span class="font-display text-xl text-brand">{group.price}</span>
                        </div>
                        <ul class="grid gap-2 sm:grid-cols-2">
                          {group.items.map((item) => (
                            <li class="rounded-xl border border-white/10 px-4 py-3 text-white/80">{item}</li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              )
            }
          </div>
        );
      })
    }

    <ul data-reveal="fade" class="mt-12 space-y-3 text-sm text-white/60 md:text-base">
      {pricing.notes.map((note) => (
        <li id={note.id} class="flex scroll-mt-28 gap-3">
          <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
          <span>
            {note.id === 'pricing-note-door' && <span class="text-brand" aria-hidden="true">* </span>}
            {note.text}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pricing-tab--closed {
    opacity: 0.75;
  }

  .pricing-tab-strike {
    position: absolute;
    left: 4%;
    top: 50%;
    z-index: 1;
    width: 118%;
    max-height: 1.05rem;
    transform: translateY(-50%) rotate(-9deg);
    object-fit: fill;
  }
</style>

<script>
  const tabs = document.querySelectorAll('[data-pricing-tab]');
  const panels = document.querySelectorAll('[data-pricing-panel]');

  function scrollToPricingNote(id: string) {
    document.getElementById(id)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  document.querySelectorAll('[data-pricing-footnote]').forEach((footnote) => {
    const id = footnote.getAttribute('data-pricing-footnote');
    if (!id) return;

    const goToNote = (event: Event) => {
      event.preventDefault();
      event.stopPropagation();
      scrollToPricingNote(id);
    };

    footnote.addEventListener('click', goToNote);
    footnote.addEventListener('keydown', (event) => {
      if (event instanceof KeyboardEvent && (event.key === 'Enter' || event.key === ' ')) {
        goToNote(event);
      }
    });
  });

  function setTabActiveStyles(button: Element, active: boolean) {
    const status = button.getAttribute('data-period-status');
    const isClosed = button.classList.contains('pricing-tab--closed');

    button.classList.toggle('border-brand', active && status === 'active');
    button.classList.toggle('bg-brand', active && status === 'active');
    button.classList.toggle('text-black', active && status === 'active');
    button.classList.toggle('border-brand/60', active && status !== 'active');
    button.classList.toggle('bg-brand/20', active && status !== 'active');
    button.classList.toggle('text-white', active && status !== 'active');
    button.classList.toggle('border-white/20', !active);
    button.classList.toggle('text-white/70', !active && !isClosed);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const id = tab.getAttribute('data-pricing-tab');
      if (!id) return;

      tabs.forEach((button) => {
        setTabActiveStyles(button, button.getAttribute('data-pricing-tab') === id);
      });

      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-pricing-panel') !== id);
      });
    });
  });
</script>
