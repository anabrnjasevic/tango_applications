---
import { copy, pricing, site } from '../data/site';
---

<section id="tickets" class="section-pad bg-surface">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 text-center">
      <h2 data-reveal="fade" class="font-display text-4xl text-white md:text-6xl">{pricing.headline}</h2>
      <p data-reveal="fade" data-reveal-delay="100" class="mt-4 text-xl text-brand-light">{pricing.subheadline}</p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      {pricing.tiers.map((tier, index) => (
        <article
          data-reveal="scale"
          data-reveal-delay={String(index * 150)}
          class:list={[tier.featured ? 'card-brand' : 'card-dark', 'flex flex-col']}
        >
          <div class="flex items-start justify-between gap-4">
            <h3 class:list={['font-display text-2xl', tier.featured ? 'text-black' : 'text-white']}>
              {tier.name}
            </h3>
            <p class:list={['font-display text-5xl', tier.featured ? 'text-black' : 'text-brand']}>
              {tier.price}
            </p>
          </div>

          <ul class="mt-8 flex-1 space-y-3">
            {tier.features.map((feature) => (
              <li class:list={['flex items-center gap-3 text-sm', tier.featured ? 'text-black/80' : 'text-white/75']}>
                <span class:list={['h-1.5 w-1.5 rounded-full', tier.featured ? 'bg-black' : 'bg-brand']}></span>
                {feature}
              </li>
            ))}
          </ul>

          <a
            href={site.registerUrl}
            class:list={[
              'mt-8 inline-flex justify-center rounded-full px-6 py-3 text-sm font-semibold uppercase tracking-wider transition-all duration-300 hover:scale-105 active:scale-95',
              tier.featured
                ? 'bg-black text-white hover:bg-black/80'
                : 'bg-brand text-black hover:bg-brand-light',
            ]}
          >
            {copy.heroCtaRegister}
          </a>
        </article>
      ))}
    </div>

    <p data-reveal="fade" class="font-display mt-12 text-center text-2xl text-white md:text-3xl">
      {pricing.deadline}
    </p>
  </div>
</section>
