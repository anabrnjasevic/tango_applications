---
import { venue } from '../data/site';
---

<section id="venue" class="section-pad bg-surface-elevated">
  <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-2">
    <div data-reveal="left">
      <h2 class="font-display mb-10 text-4xl text-white md:text-6xl">{venue.headline}</h2>

      <div class="space-y-8">
        <div>
          <h3 class="font-display text-3xl text-brand-light">{venue.workshops.title}</h3>
          <p class="mt-3 text-lg text-white/70">{venue.workshops.body}</p>
        </div>
        <div>
          <h3 class="font-display text-3xl text-brand-light">{venue.milongas.title}</h3>
          <p class="mt-3 text-lg text-white/70">{venue.milongas.body}</p>
        </div>
      </div>
    </div>

    <div data-reveal="right" class="group overflow-hidden rounded-2xl border border-white/10">
      <img
        src="/images/venue.png"
        alt="Dance venue with polished wooden floor"
        class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105"
      />
    </div>
  </div>
</section>
