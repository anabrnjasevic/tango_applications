---
import { venue } from '../data/site';
---

<section id="venue" class="section-pad bg-surface-elevated">
  <div class="mx-auto max-w-7xl">
    <div data-reveal="fade" class="mb-10">
      <h2 class="font-display text-4xl text-white md:text-6xl">{venue.headline}</h2>
      <p class="mt-4 max-w-3xl text-lg text-white/60">{venue.walkingNote}</p>
    </div>

    <div class="grid gap-8 lg:grid-cols-3 lg:gap-10">
      {
        venue.locations.map((location, index) => (
          <article data-reveal data-reveal-delay={String(index * 100)} class="flex flex-col">
            {'image' in location && location.image ? (
              <div class="group mb-6 overflow-hidden rounded-2xl border border-white/10">
                <img
                  src={location.image}
                  alt={'imageAlt' in location ? location.imageAlt : location.name}
                  class="aspect-[4/3] w-full object-cover transition duration-700 group-hover:scale-105"
                />
              </div>
            ) : null}

            <h3 class="font-display text-3xl text-brand-light">{location.title}</h3>
            <p class="mt-2 font-display text-xl text-white">{location.name}</p>
            <p class="mt-1 text-white/70">
              {location.address.map((line) => (
                <>
                  {line}
                  <br />
                </>
              ))}
            </p>
            {'email' in location && location.email ? (
              <a
                href={`mailto:${location.email}`}
                class="mt-2 text-brand-light transition-colors hover:text-brand"
              >
                {location.email}
              </a>
            ) : null}
            <p class="mt-4 flex-1 text-lg leading-relaxed text-white/70">{location.description}</p>
            {'capacityNote' in location && location.capacityNote ? (
              <p class="mt-4 rounded-xl border border-brand/30 bg-brand/10 px-4 py-3 text-sm font-medium text-brand-light">
                {location.capacityNote}
              </p>
            ) : null}
            <a
              href={location.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-brand-light transition-colors hover:text-brand"
            >
              Open in Google Maps
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 15h-8.5A2.25 2.25 0 012 12.75v-8.5A2.25 2.25 0 014.25 2h5a.75.75 0 010 1.5h-5z"
                  clip-rule="evenodd"
                />
                <path
                  fill-rule="evenodd"
                  d="M6.194 12.753a.75.75 0 001.06.053L16.5 4.44v2.81a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.553l-9.056 8.194a.75.75 0 00-.053 1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
