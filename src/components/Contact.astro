---
import { copy, site } from '../data/site';
import { getRegistrationState } from '../lib/registration-schedule';

const registration = getRegistrationState();
---

<section id="contact" class="section-pad bg-surface">
  <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-2">
    <div data-reveal="left">
      <h2 class="font-display text-4xl text-white md:text-6xl">{copy.contactHeadline}</h2>
      <p class="mt-4 text-lg text-white/70">{copy.contactIntro}</p>

      <ul class="mt-10 space-y-4 text-lg">
        <li>
          <a href={`mailto:${site.contactEmail}`} class="text-brand-light hover:text-brand">
            {site.contactEmail}
          </a>
        </li>
        <li class="text-white/75">{site.address}</li>
        <li>
          <a href={`tel:${site.contactPhone.replace(/\s/g, '')}`} class="text-white/75 hover:text-white">
            {site.contactPhone}
          </a>
        </li>
      </ul>
    </div>

    <div data-reveal="right" class="card-dark flex flex-col justify-center">
      <p class="text-white/70">
        {copy.contactCard}
      </p>
      <a href={registration.ctaHref} class="btn-primary mt-8 w-full text-center">
        {registration.isRegistrationOpen ? copy.contactCardCta : registration.ctaLabel}
      </a>
    </div>
  </div>
</section>

<section class="bg-brand section-pad">
  <div class="mx-auto max-w-4xl text-center">
    <h2 data-reveal="fade" class="font-display text-4xl text-black md:text-6xl">{copy.connectHeadline}</h2>
    <p data-reveal="fade" data-reveal-delay="100" class="mx-auto mt-6 max-w-2xl text-lg font-medium text-black/80">
      {copy.connectCta}
    </p>
    <a
      href={`mailto:${site.contactEmail}`}
      data-reveal="scale"
      data-reveal-delay="200"
      class="mt-10 inline-flex rounded-full bg-black px-10 py-4 text-sm font-semibold uppercase tracking-wider text-white transition-all duration-300 hover:scale-105 hover:bg-black/80 active:scale-95"
    >
      {copy.connectCtaButton}
    </a>
  </div>
</section>
