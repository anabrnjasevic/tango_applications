---
import { copy, glance, site } from '../data/site';
---

<section class="section-pad bg-surface">
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
      <h2 data-reveal="left" class="font-display text-4xl text-white md:text-6xl">Event at a glance</h2>
      <p data-reveal="right" class="max-w-lg text-white/70">
        {copy.glanceSubhead}
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {glance.map((item, index) => (
        <article data-reveal="scale" data-reveal-delay={String(index * 100)} class="card-dark">
          <h3 class="font-display text-2xl text-brand-light">{item.title}</h3>
          <p class="mt-3 text-white/70">{item.body}</p>
        </article>
      ))}
    </div>

    <div data-reveal="fade" class="mt-12 text-center">
      <a href={site.registerUrl} class="btn-primary">
        Get a ticket
      </a>
    </div>
  </div>
</section>
