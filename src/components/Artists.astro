---
import { artists, copy, site } from '../data/site';

const { videoUrl } = artists;
---

<section id="artists" class="section-pad bg-surface">
  <div class="mx-auto max-w-7xl">
    <h2 data-reveal class="font-display mb-12 text-4xl leading-tight text-white md:text-6xl">
      {artists.headline}
    </h2>

    <div class="grid gap-8 md:grid-cols-2 lg:gap-12">
      <div data-reveal="left" class="space-y-6 text-lg leading-relaxed text-white/75 md:text-xl">
        <p class="font-display text-3xl text-brand-light md:text-4xl">{artists.names}</p>

        <p>{artists.tagline}</p>

        <p>{artists.credentials}</p>

        <p>
          {artists.introBeforeEmphasis}
          <span class="font-semibold uppercase text-brand-light">{artists.introEmphasis}</span>
          {artists.introAfterEmphasis}
        </p>

        <p class="font-semibold uppercase tracking-wider text-brand md:text-xl">
          {artists.calloutEmphasis}
          <span class="normal-case tracking-normal">{artists.calloutRest}</span>
        </p>
      </div>

      <div data-reveal="right" class="space-y-6 text-lg leading-relaxed text-white/75 md:text-xl">
        {artists.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>

    <div data-reveal class="mx-auto mt-14 max-w-4xl lg:max-w-5xl">
      {videoUrl ? (
        <div class="overflow-hidden rounded-2xl border border-white/10 shadow-2xl shadow-black/40">
          <div class="aspect-video">
            <iframe
              src={videoUrl}
              title="Carlos and Mirella — promo video"
              class="h-full w-full"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          </div>
        </div>
      ) : (
        <div class="group relative overflow-hidden rounded-2xl border border-white/10">
          <img
            src="/images/artist-feature.png"
            alt="Carlos and Mirella performing on stage"
            class="aspect-video w-full object-cover transition duration-700 group-hover:scale-105"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6">
            <p class="font-display text-2xl text-white">Carlos & Mirella Santos David</p>
            <p class="text-white/70">Featured artists · Gala performance Sunday</p>
          </div>
        </div>
      )}
    </div>

    <div
      data-reveal="scale"
      data-reveal-delay="200"
      class="mt-14 rounded-2xl border border-brand/30 bg-surface-elevated px-6 py-10 text-center md:px-10 md:py-12">
      <p class="font-display text-2xl text-white md:text-3xl">{copy.saveTheDate}</p>
      <a
        href={site.registerUrl}
        class="btn-primary mt-8 inline-flex px-12 py-4 text-base md:text-lg">
        {copy.heroCtaRegister}
      </a>
    </div>

    <p
      data-reveal
      data-reveal-delay="200"
      class="font-display mt-16 border-t border-white/10 pt-10 text-center text-3xl text-white md:text-5xl">
      {artists.gala}
    </p>
  </div>
</section>
