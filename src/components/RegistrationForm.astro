---
import {
  dancingYearsOptions,
  googleForm,
  individualTicketGroups,
  roleOptions,
  yesNoOptions,
} from '../data/form';
import { fieldLimits, skipTurnstile } from '../lib/form-security';
import { getRegistrationState } from '../lib/registration-schedule';
import { showDisabledIndividualTickets } from '../data/site';

const registration = getRegistrationState();
const turnstileOff = skipTurnstile();

const turnstileSiteKey = turnstileOff
  ? ''
  : String(import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? '').trim();

const showIndividualTickets =
  registration.individualTicketsAvailable || showDisabledIndividualTickets;

const turnstileRequired = !turnstileOff && Boolean(turnstileSiteKey);
const canSubmit = turnstileOff || turnstileRequired;
---

{
  !registration.isRegistrationOpen ? (
    <div class="rounded-2xl border border-white/10 bg-surface-card p-8 text-center">
      <p class="font-display text-2xl text-brand-light">
        {registration.isBeforeOpen
          ? registration.registrationNotOpenMessage
          : registration.registrationClosedMessage}
      </p>
      <a href="#tickets" class="btn-primary mt-6 inline-flex">
        {registration.ctaLabel}
      </a>
    </div>
  ) : (
    <form id="registration-form" class="space-y-8" novalidate>
      <fieldset class="space-y-4">
        <legend class="font-display text-2xl text-brand-light">Contact information</legend>

        <label class="field">
          <span class="field-label">Surname and name *</span>
          <input type="text" name="name" required autocomplete="name" maxlength={fieldLimits.name} class="field-input" />
        </label>

        <label class="field">
          <span class="field-label">Email *</span>
          <input type="email" name="email" required autocomplete="email" maxlength={fieldLimits.email} class="field-input" />
        </label>

        <label class="field">
          <span class="field-label">Phone number *</span>
          <input type="tel" name="phone" required autocomplete="tel" maxlength={fieldLimits.phone} class="field-input" />
        </label>

        <label class="field">
          <span class="field-label">Country and place *</span>
          <input type="text" name="location" required autocomplete="address-level1" maxlength={fieldLimits.location} class="field-input" />
        </label>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="field-label mb-1 block">How long have you been dancing? *</legend>
        {
          dancingYearsOptions.map((option) => (
            <label class="choice">
              <input type="radio" name="dancingYears" value={option} required class="choice-input" />
              <span>{option}</span>
            </label>
          ))
        }
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="field-label mb-1 block">Have you performed as a tango dancer? *</legend>
        {
          yesNoOptions.map((option) => (
            <label class="choice">
              <input type="radio" name="performed" value={option} required class="choice-input" />
              <span>{option}</span>
            </label>
          ))
        }
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="field-label mb-1 block">Are you a tango instructor? *</legend>
        {
          yesNoOptions.map((option) => (
            <label class="choice">
              <input type="radio" name="instructor" value={option} required class="choice-input" />
              <span>{option}</span>
            </label>
          ))
        }
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="field-label mb-1 block">I apply as: *</legend>
        {
          roleOptions.map((option) => (
            <label class="choice">
              <input
                type="radio"
                name="role"
                value={option.value}
                required
                class="choice-input"
                data-needs-partner={option.needsPartner ? 'true' : undefined}
              />
              <span>{option.label}</span>
            </label>
          ))
        }
        <label id="partner-field" class="field hidden">
          <span class="field-label">Partner's surname and name *</span>
          <input type="text" name="partnerName" maxlength={fieldLimits.partnerName} class="field-input" />
        </label>
      </fieldset>

      <fieldset id="package-fieldset" class="space-y-3">
        <legend class="field-label mb-1 block">Choose your package</legend>
        <p class="field-hint">
          Pick one. Skip this if you only want add-ons
          {
            registration.individualTicketsAvailable
              ? ' (Escenario and/or individual tickets).'
              : ` (Escenario now, or individual tickets from ${registration.individualTicketsAvailableFromLabel}).`
          }
        </p>
        {
          registration.formPackages.map((option) => (
            <label class="choice">
              <input type="radio" name="package" value={option.value} class="choice-input" />
              <span>{option.label}</span>
            </label>
          ))
        }
        <p id="package-error" class="field-error hidden"></p>
      </fieldset>

      <fieldset class="space-y-3">
        <legend class="field-label mb-1 block">Add-ons</legend>
        {
          registration.formEscenario && (
            <label class="choice">
              <input
                type="checkbox"
                name="addons"
                value={registration.formEscenario.value}
                class="choice-input"
              />
              <span>{registration.formEscenario.label}</span>
            </label>
          )
        }
        {
          showIndividualTickets && (
            <div class="space-y-3">
              <p class="text-sm font-semibold uppercase tracking-wider text-brand">Individual tickets</p>
              {!registration.individualTicketsAvailable && (
                <p class="field-hint">
                  Individual tickets only — available from {registration.individualTicketsAvailableFromLabel} (Regular registration).
                </p>
              )}
              {
                individualTicketGroups.map((group) => (
                  <div class="space-y-2">
                    <p class="text-sm font-semibold uppercase tracking-wider text-brand">{group.category}</p>
                    {group.choices.map((option) => (
                      <label class:list={['choice', !registration.individualTicketsAvailable && 'opacity-50']}>
                        <input
                          type="checkbox"
                          name="addons"
                          value={option.value}
                          class="choice-input"
                          disabled={!registration.individualTicketsAvailable}
                        />
                        <span>{option.label}</span>
                      </label>
                    ))}
                  </div>
                ))
              }
            </div>
          )
        }
      </fieldset>

      <label class="field">
        <span class="field-label">Anything you want to share?</span>
        <textarea name="notes" rows="4" maxlength={fieldLimits.notes} class="field-input resize-y"></textarea>
      </label>

      <label class="field-honeypot" aria-hidden="true">
        <span>Website</span>
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>

      {
        turnstileOff ? null : turnstileRequired ? (
          <div
            id="turnstile-widget"
            class="cf-turnstile"
            data-sitekey={turnstileSiteKey}
            data-theme="dark"
          />
        ) : (
          <p class="text-sm text-red-300">Registration is temporarily unavailable. Missing Turnstile configuration.</p>
        )
      }

      <p id="form-message" class="hidden rounded-xl border px-4 py-3 text-sm" role="status" aria-live="polite"></p>

      <button
        type="submit"
        class="btn-primary w-full disabled:cursor-not-allowed disabled:opacity-60"
        disabled={!canSubmit}
      >
        Submit application
      </button>
    </form>
  )
}

{
  !turnstileOff && (
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  )
}

<script
  define:vars={{
    successMessage: googleForm.successMessage,
    coupleOptionValue: roleOptions.find((option) => option.needsPartner)?.value ?? '',
    turnstileRequired,
    registrationOpen: registration.isRegistrationOpen,
    individualsAvailable: registration.individualTicketsAvailable,
  }}
>
  const form = document.getElementById('registration-form');
  const message = document.getElementById('form-message');
  const partnerField = document.getElementById('partner-field');
  const partnerInput = form?.querySelector('input[name="partnerName"]');
  const packageError = document.getElementById('package-error');

  function setMessage(text, type) {
    if (!message) return;
    message.textContent = text;
    message.classList.remove(
      'hidden',
      'border-brand/40',
      'bg-brand/10',
      'text-brand-light',
      'border-red-400/40',
      'bg-red-500/10',
      'text-red-200',
    );
    if (type === 'success') {
      message.classList.add('border-brand/40', 'bg-brand/10', 'text-brand-light');
    } else {
      message.classList.add('border-red-400/40', 'bg-red-500/10', 'text-red-200');
    }
  }

  function setPackageError(text) {
    if (!packageError) return;
    packageError.textContent = text ?? '';
    packageError.classList.toggle('hidden', !text);
  }

  function updatePartnerField() {
    const selected = form?.querySelector('input[name="role"]:checked');
    const showPartner = selected?.value === coupleOptionValue;
    partnerField?.classList.toggle('hidden', !showPartner);
    if (partnerInput) {
      partnerInput.required = Boolean(showPartner);
      if (!showPartner) partnerInput.value = '';
    }
  }

  form?.querySelectorAll('input[name="role"]').forEach((input) => {
    input.addEventListener('change', updatePartnerField);
  });

  function selectedProducts() {
    const main = form?.querySelector('input[name="package"]:checked');
    const addons = Array.from(form?.querySelectorAll('input[name="addons"]:checked') ?? []).map(
      (input) => input.value,
    );
    return {
      main: main ? main.value : '',
      addons,
      packages: [...(main ? [main.value] : []), ...addons],
    };
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !registrationOpen) return;

    setPackageError('');

    if (!form.reportValidity()) {
      setMessage('Please fill in all required fields.', 'error');
      return;
    }

    const { packages } = selectedProducts();

    if (!packages.length) {
      const errorText = individualsAvailable
        ? 'Please choose a package or at least one add-on.'
        : 'Please choose a package or Escenario. Individual tickets open on 8 September.';
      setPackageError(errorText);
      setMessage(errorText, 'error');
      return;
    }

    const turnstileToken = turnstileRequired
      ? (document.querySelector('[name="cf-turnstile-response"]')?.value ?? '')
      : 'dev-skip';

    if (turnstileRequired && !turnstileToken) {
      setMessage('Please complete the security check.', 'error');
      return;
    }

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') ?? ''),
      email: String(formData.get('email') ?? ''),
      phone: String(formData.get('phone') ?? ''),
      location: String(formData.get('location') ?? ''),
      dancingYears: String(formData.get('dancingYears') ?? ''),
      performed: String(formData.get('performed') ?? ''),
      instructor: String(formData.get('instructor') ?? ''),
      role: String(formData.get('role') ?? ''),
      partnerName: String(formData.get('partnerName') ?? ''),
      packages,
      notes: String(formData.get('notes') ?? ''),
      website: String(formData.get('website') ?? ''),
      turnstileToken,
    };

    if (payload.role === coupleOptionValue && !payload.partnerName.trim()) {
      setMessage('Please enter your partner\'s name.', 'error');
      return;
    }

    const submitButton = form.querySelector('button[type="submit"]');
    if (submitButton) submitButton.disabled = true;
    setMessage('Sending…', 'success');

    try {
      const registerResponse = await fetch('/api/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const registerResult = await registerResponse.json();

      if (!registerResponse.ok || !registerResult.ok) {
        setMessage(registerResult.error ?? 'Something went wrong. Please try again.', 'error');
        window.turnstile?.reset?.();
        return;
      }

      form.reset();
      updatePartnerField();
      setPackageError('');
      window.turnstile?.reset?.();
      setMessage(registerResult.message ?? successMessage, 'success');
    } catch {
      setMessage('Could not submit the form. Please refresh and try again.', 'error');
      window.turnstile?.reset?.();
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
