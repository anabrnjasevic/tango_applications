---
import { noviSad } from '../data/site';
---

<section class="section-pad bg-surface">
  <div class="mx-auto max-w-7xl">
    <div data-reveal="fade" class="mb-10 text-center">
      <h2 class="font-display text-4xl text-white md:text-6xl">{noviSad.headline}</h2>
      <p class="mt-3 font-display text-xl text-brand-light md:text-2xl">{noviSad.subheadline}</p>
      <p class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-white/70">{noviSad.intro}</p>
    </div>

    <div data-reveal="scale" class="group mb-12 overflow-hidden rounded-2xl border border-white/10">
      <img
        src={noviSad.image}
        alt={noviSad.imageAlt}
        class="aspect-[16/9] w-full object-cover transition duration-700 group-hover:scale-105"
        loading="lazy"
      />
    </div>

    <div class="grid gap-6 md:grid-cols-2">
      {
        noviSad.highlights.map((item, index) => (
          <article
            data-reveal="scale"
            data-reveal-delay={String(index * 100)}
            class="card-dark flex flex-col"
          >
            <h3 class="font-display text-2xl text-brand-light">{item.title}</h3>
            <p class="mt-4 flex-1 text-lg leading-relaxed text-white/70">{item.body}</p>
          </article>
        ))
      }
    </div>

    <p data-reveal="fade" class="mx-auto mt-10 max-w-3xl text-center text-lg leading-relaxed text-white/75">
      {noviSad.closing}
    </p>
  </div>
</section>
